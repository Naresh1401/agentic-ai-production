# Copy to .env and fill in. NEVER commit real keys.

# LLM provider (use whichever you have)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Default model used by examples
DEFAULT_MODEL=gpt-4o-mini

# Observability (optional)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
OTEL_EXPORTER_OTLP_ENDPOINT=

# App
APP_ENV=dev
LOG_LEVEL=INFO
