# Copy to .env and fill in. NEVER commit real keys.

# LLM provider (use whichever you have)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Model behavior
DEFAULT_MODEL=gpt-4o-mini
MAX_TOKENS=1024
MAX_RETRIES=2
REQUEST_TIMEOUT_SECONDS=30

# Service auth (leave off for local dev)
REQUIRE_AUTH=false
API_KEY=

# Safety
ENABLE_GUARDRAILS=true

# CORS: comma-separated origins ("*" for dev, restrict in prod)
CORS_ALLOW_ORIGINS=*

# Observability (optional)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
OTEL_EXPORTER_OTLP_ENDPOINT=

# App
APP_ENV=dev
LOG_LEVEL=INFO
